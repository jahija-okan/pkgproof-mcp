{
	"name": "@pkgproof/mcp",
	"version": "0.1.9",
	"mcpName": "net.pkgproof/pkgproof",
	"description": "Verify an npm package before you install it. MCP server for pkgproof.",
	"keywords": [
		"mcp",
		"modelcontextprotocol",
		"npm",
		"security",
		"supply-chain",
		"typosquat",
		"x402"
	],
	"license": "Apache-2.0",
	"homepage": "https://pkgproof.net",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jahija-okan/pkgproof-mcp.git"
	},
	"bugs": {
		"url": "https://github.com/jahija-okan/pkgproof-mcp/issues"
	},
	"type": "module",
	"bin": {
		"pkgproof-mcp": "dist/index.js"
	},
	"files": [
		"dist",
		"NOTICE"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc",
		"mcpb": "node scripts/build-mcpb.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"inspector": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "npm run typecheck && npm run format:check && eslint .",
		"lint:fix": "prettier --write . && eslint . --fix",
		"prepublishOnly": "npm run build",
		"version": "node scripts/sync-version.js"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "2.3.1",
		"@x402/avm": "2.28.0",
		"@x402/core": "2.28.0",
		"@x402/evm": "2.28.0",
		"viem": "2.57.3",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"@modelcontextprotocol/client": "2.3.1",
		"@types/node": "26.6.4",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "8.71.1",
		"eslint": "9.39.2",
		"eslint-config-prettier": "10.1.8",
		"globals": "^17.13.0",
		"prettier": "3.9.9",
		"typescript": "5.9.3",
		"vitest": "5.0.3"
	}
}
